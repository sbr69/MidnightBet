pragma language_version >= 0.23.0;

import CompactStandardLibrary;

enum GamePhase {
    WaitingForPlayers,
    InProgress,
    Finished,
    Cancelled
}

struct UserSecretKey { bytes: Bytes<32>; }
struct UserPublicKey { bytes: Bytes<32>; }

// ----------------------------------------------------
// Public Ledger State
// ----------------------------------------------------

// Global token balances
export ledger balances: Map<UserPublicKey, Uint<64>>;

// Per-room metadata (keyed by roomId: Bytes<32>)
export ledger roomPhase: Map<Bytes<32>, GamePhase>;
export ledger roomCreator: Map<Bytes<32>, UserPublicKey>;
export ledger roomMaxPlayers: Map<Bytes<32>, Uint<8>>;
export ledger roomPlayerCount: Map<Bytes<32>, Uint<32>>;
export ledger roomRangeMin: Map<Bytes<32>, Uint<64>>;
export ledger roomRangeMax: Map<Bytes<32>, Uint<64>>;
export ledger roomStakeAmount: Map<Bytes<32>, Uint<64>>;
export ledger roomTotalPool: Map<Bytes<32>, Uint<64>>;
export ledger roomTargetHash: Map<Bytes<32>, Bytes<32>>;
export ledger roomWinner: Map<Bytes<32>, UserPublicKey>;

// Per-room round management
export ledger roomCurrentRound: Map<Bytes<32>, Uint<32>>;
export ledger roomRoundGuesses: Map<Bytes<32>, Uint<32>>;
export ledger roomGiveUpCount: Map<Bytes<32>, Uint<32>>;

// Per-room per-player state (keyed by composite key: persistentHash([roomId, player.bytes]))
export ledger roomPlayers: Map<Bytes<32>, Boolean>;
export ledger roomPlayerAtIndex: Map<Bytes<32>, UserPublicKey>;
export ledger roomLatestGuesses: Map<Bytes<32>, Uint<64>>;
export ledger roomLastGuessedRound: Map<Bytes<32>, Uint<32>>;
export ledger roomHasGivenUp: Map<Bytes<32>, Boolean>;

// ----------------------------------------------------
// Witnesses
// ----------------------------------------------------

witness getUserSecret(): UserSecretKey;
witness getTargetSalt(): Bytes<32>;

// ----------------------------------------------------
// Helpers
// ----------------------------------------------------

export circuit deriveUserPublicKey(sk: UserSecretKey): UserPublicKey {
    return UserPublicKey {
        bytes: persistentHash<Vector<2, Bytes<32>>>([
            pad(32, "midnightbet:user:v1"),
            sk.bytes
        ])
    };
}

export circuit roomPlayerKey(roomId: Bytes<32>, player: UserPublicKey): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([
        roomId,
        player.bytes
    ]);
}

export circuit roomIndexKey(roomId: Bytes<32>, index: Uint<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([
        roomId,
        persistentCommit<Uint<64>>(index as Uint<64>, pad(32, "midnightbet:idx:v1"))
    ]);
}

export circuit getBalance(account: UserPublicKey): Uint<64> {
    if (!balances.member(disclose(account))) {
        return 0;
    }
    return balances.lookup(disclose(account));
}

// ----------------------------------------------------
// Circuits
// ----------------------------------------------------

constructor() {
    // Single Hub contract deployed once; no parameters required
}

// Internal token faucet for testing
export circuit faucet(): [] {
    const caller = disclose(deriveUserPublicKey(getUserSecret()));
    const bal = getBalance(caller);
    balances.insert(caller, disclose((bal + 1000) as Uint<64>));
}

export circuit createRoom(
    roomId: Bytes<32>,
    maxPlayers: Uint<8>,
    rangeMin: Uint<64>,
    rangeMax: Uint<64>,
    stakeAmount: Uint<64>,
    targetHash: Bytes<32>
): [] {
    const dRoom = disclose(roomId);
    assert(!roomPhase.member(dRoom), "Room already exists");
    assert(disclose(maxPlayers) >= 2, "Need at least 2 players");
    assert(disclose(rangeMax) > disclose(rangeMin), "Invalid range");

    const caller = disclose(deriveUserPublicKey(getUserSecret()));

    roomCreator.insert(dRoom, caller);
    roomMaxPlayers.insert(dRoom, disclose(maxPlayers));
    roomRangeMin.insert(dRoom, disclose(rangeMin));
    roomRangeMax.insert(dRoom, disclose(rangeMax));
    roomStakeAmount.insert(dRoom, disclose(stakeAmount));
    roomTargetHash.insert(dRoom, disclose(targetHash));

    roomPhase.insert(dRoom, GamePhase.WaitingForPlayers);
    roomPlayerCount.insert(dRoom, 0);
    roomTotalPool.insert(dRoom, 0);
    roomCurrentRound.insert(dRoom, 0);
    roomRoundGuesses.insert(dRoom, 0);
    roomGiveUpCount.insert(dRoom, 0);
}

export circuit joinRoom(roomId: Bytes<32>): [] {
    const dRoom = disclose(roomId);
    assert(roomPhase.member(dRoom), "Room does not exist");
    assert(roomPhase.lookup(dRoom) == GamePhase.WaitingForPlayers, "Room not accepting players");

    const caller = disclose(deriveUserPublicKey(getUserSecret()));
    const pKey = roomPlayerKey(dRoom, caller);

    assert(!roomPlayers.member(pKey) || roomPlayers.lookup(pKey) == false, "Already joined this room");

    const stake = roomStakeAmount.lookup(dRoom);
    const bal = getBalance(caller);
    assert(bal >= stake, "Insufficient balance for stake");

    balances.insert(caller, disclose((bal - stake) as Uint<64>));
    roomPlayers.insert(pKey, true);

    const prevCount = roomPlayerCount.lookup(dRoom);
    roomPlayerAtIndex.insert(roomIndexKey(dRoom, prevCount), caller);
    const newCount = (prevCount + 1) as Uint<32>;
    roomPlayerCount.insert(dRoom, disclose(newCount));

    const prevPool = roomTotalPool.lookup(dRoom);
    roomTotalPool.insert(dRoom, disclose((prevPool + stake) as Uint<64>));

    const maxP = roomMaxPlayers.lookup(dRoom) as Uint<32>;
    if (newCount == maxP) {
        roomPhase.insert(dRoom, GamePhase.InProgress);
        roomCurrentRound.insert(dRoom, 1);
        roomRoundGuesses.insert(dRoom, 0);
    }
}

export circuit guess(roomId: Bytes<32>, number: Uint<64>): [] {
    const dRoom = disclose(roomId);
    assert(roomPhase.member(dRoom), "Room does not exist");
    assert(roomPhase.lookup(dRoom) == GamePhase.InProgress, "Room not in progress");

    const rMin = roomRangeMin.lookup(dRoom);
    const rMax = roomRangeMax.lookup(dRoom);
    const dNumber = disclose(number);
    assert(dNumber >= rMin && dNumber <= rMax, "Guess out of range");

    const caller = disclose(deriveUserPublicKey(getUserSecret()));
    const pKey = roomPlayerKey(dRoom, caller);

    assert(roomPlayers.member(pKey) && roomPlayers.lookup(pKey) == true, "Not an active player");
    assert(!roomHasGivenUp.member(pKey) || roomHasGivenUp.lookup(pKey) == false, "Player has given up");

    const currentR = roomCurrentRound.lookup(dRoom);
    if (roomLastGuessedRound.member(pKey)) {
        assert(roomLastGuessedRound.lookup(pKey) < currentR, "Already guessed this round — wait for others");
    }

    roomLatestGuesses.insert(pKey, dNumber);
    roomLastGuessedRound.insert(pKey, currentR);

    const prevGuesses = roomRoundGuesses.lookup(dRoom);
    const newGuesses = (prevGuesses + 1) as Uint<32>;
    roomRoundGuesses.insert(dRoom, disclose(newGuesses));

    const activePlayers = roomPlayerCount.lookup(dRoom) - roomGiveUpCount.lookup(dRoom);
    if (newGuesses == activePlayers) {
        roomCurrentRound.insert(dRoom, (currentR + 1) as Uint<32>);
        roomRoundGuesses.insert(dRoom, 0);
    }
}

export circuit declareWinner(roomId: Bytes<32>, player: UserPublicKey, targetNumber: Uint<64>): [] {
    const dRoom = disclose(roomId);
    assert(roomPhase.member(dRoom), "Room does not exist");
    assert(roomPhase.lookup(dRoom) == GamePhase.InProgress, "Room not in progress");

    const caller = disclose(deriveUserPublicKey(getUserSecret()));
    assert(caller == roomCreator.lookup(dRoom), "Only creator can declare winner");

    const salt = getTargetSalt();
    const dTarget = disclose(targetNumber);
    assert(roomTargetHash.lookup(dRoom) == persistentCommit<Uint<64>>(targetNumber, salt), "Target hash mismatch");

    const dPlayer = disclose(player);
    const pKey = roomPlayerKey(dRoom, dPlayer);

    assert(roomLatestGuesses.member(pKey), "Player has no recorded guess");
    assert(roomLatestGuesses.lookup(pKey) == dTarget, "Player's guess does not match target");

    roomPhase.insert(dRoom, GamePhase.Finished);
    roomWinner.insert(dRoom, dPlayer);

    const pool = roomTotalPool.lookup(dRoom);
    const winnerBal = getBalance(dPlayer);
    balances.insert(dPlayer, disclose((winnerBal + pool) as Uint<64>));
}

export circuit giveUp(roomId: Bytes<32>): [] {
    const dRoom = disclose(roomId);
    assert(roomPhase.member(dRoom), "Room does not exist");
    assert(roomPhase.lookup(dRoom) == GamePhase.InProgress, "Room not in progress");

    const caller = disclose(deriveUserPublicKey(getUserSecret()));
    const pKey = roomPlayerKey(dRoom, caller);

    assert(roomPlayers.member(pKey) && roomPlayers.lookup(pKey) == true, "Not an active player");
    assert(!roomHasGivenUp.member(pKey) || roomHasGivenUp.lookup(pKey) == false, "Already gave up");

    roomHasGivenUp.insert(pKey, true);

    const prevGiveUps = roomGiveUpCount.lookup(dRoom);
    const newGiveUps = (prevGiveUps + 1) as Uint<32>;
    roomGiveUpCount.insert(dRoom, disclose(newGiveUps));

    if (newGiveUps == roomPlayerCount.lookup(dRoom)) {
        roomPhase.insert(dRoom, GamePhase.Cancelled);
    }
}

export circuit cancelRoom(roomId: Bytes<32>): [] {
    const dRoom = disclose(roomId);
    assert(roomPhase.member(dRoom), "Room does not exist");
    assert(roomPhase.lookup(dRoom) == GamePhase.WaitingForPlayers, "Cannot cancel active room");

    const caller = disclose(deriveUserPublicKey(getUserSecret()));
    assert(caller == roomCreator.lookup(dRoom), "Only creator can cancel");

    roomPhase.insert(dRoom, GamePhase.Cancelled);
}

export circuit claimRefund(roomId: Bytes<32>): [] {
    const dRoom = disclose(roomId);
    assert(roomPhase.member(dRoom), "Room does not exist");
    assert(roomPhase.lookup(dRoom) == GamePhase.Cancelled, "Room not cancelled");

    const caller = disclose(deriveUserPublicKey(getUserSecret()));
    const pKey = roomPlayerKey(dRoom, caller);

    assert(roomPlayers.member(pKey) && roomPlayers.lookup(pKey) == true, "Not eligible for refund");

    roomPlayers.insert(pKey, false); // Mark refunded

    const stake = roomStakeAmount.lookup(dRoom);
    const bal = getBalance(caller);
    balances.insert(caller, disclose((bal + stake) as Uint<64>));
}
